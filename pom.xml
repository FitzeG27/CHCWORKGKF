<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>CHCWORKGKF</groupId>
    <artifactId>CHCWORKGKF</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>CHCWORKGKF.CHCWORKGKF</exec.mainClass>
        <lib.path>C:/Users/gkfit/OneDrive/Documents/CHCWORKGKF/lib</lib.path>
    </properties>

    <dependencies>
        <!-- JavaFX (local JARs) -->
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-base</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.base.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.controls.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.fxml.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.graphics.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-media</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.media.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-web</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.web.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/javafx.swing.jar</systemPath>
        </dependency>

        <!-- Local JARs -->
        <dependency>
            <groupId>local</groupId>
            <artifactId>apcslib</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/apcslib.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>BreezySwing</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/BreezySwing.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>bsh</artifactId>
            <version>2.0b4</version>
            <scope>system</scope>
            <systemPath>${lib.path}/bsh-2.0b4.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>exp4j</artifactId>
            <version>0.4.8</version>
            <scope>system</scope>
            <systemPath>${lib.path}/exp4j-0.4.8.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>jfx-incubator-input</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/jfx.incubator.input.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>jfx-incubator-richtext</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/jfx.incubator.richtext.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>TerminalIO</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/TerminalIO.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>local</groupId>
            <artifactId>TurtleGraphics</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${lib.path}/TurtleGraphics.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>Calculator.CalcMain</mainClass>
                    <options>
                        <option>--module-path</option>
                        <option>C:/Users/gkfit/OneDrive/Documents/CHCWORKGKF/lib</option>
                        <option>--add-modules</option>
                        <option>javafx.controls,javafx.fxml,javafx.base,javafx.graphics,javafx.media,javafx.web,javafx.swing</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>